{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ACP Task v0.3",
  "type":"object",
  "required":["id","title","objective","type","scope","acceptance","review"],
  "properties":{
    "id":{"type":"string","pattern":"^TASK-[0-9]{4,}$"},
    "title":{"type":"string","minLength":1},
    "objective":{"type":"string","minLength":1},
    "type":{"type":"string"},
    "priority":{"type":"string"},
    "scope":{"type":"object","required":["allowed"],"properties":{"allowed":{"type":"array","items":{"type":"string"}}}},
    "acceptance":{"type":"array","items":{"type":"string"}},
    "review":{"type":"object","required":["required"],"properties":{"required":{"type":"array","items":{"type":"string"}}}},
    "effort":{"enum":["low","medium","high","maximum"]},
    "budget":{"type":"object","properties":{"maxTokens":{"type":"integer"},"maxRequests":{"type":"integer"},"maxDurationMinutes":{"type":"integer"},"maxAgents":{"type":"integer"}}},
    "execution":{"type":"object","properties":{"strategy":{"enum":["sequential","parallel","swarm"]},"maxConcurrency":{"type":"integer","minimum":1},"nodes":{"type":"array"}}}
  }
}
