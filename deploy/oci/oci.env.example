# Non-secret OCI deployment inputs. Copy outside the repository and fill these in.
OCI_REGION=eu-frankfurt-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..example
OCI_OBJECT_STORAGE_NAMESPACE=examplenamespace
ACP_ARTIFACT_BUCKET=acp-nonproduction-artifacts
ACP_PUBLIC_BASE_URL=https://acp.example.com
ACP_API_IMAGE=registry.example.com/acp:0.6.2

# Reference an OCI Vault secret; never place a database URL or password here.
ACP_DATABASE_SECRET_REF=oci-vault://ocid1.vaultsecret.oc1..example

# This container must sit behind a private load balancer or access gateway until
# OIDC authentication is delivered in v0.6-4.
ACP_UI_HOST=0.0.0.0
ACP_UI_PORT=4317

# Keep these values in OCI Vault in production. They are placeholders only.
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret-from-vault
GITHUB_OAUTH_CALLBACK_URL=https://acp.example.com/auth/github/callback
ACP_SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-key-from-vault
